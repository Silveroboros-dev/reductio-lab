{"record":"database","format":"sqlite-jsonl-v1","integrity_check":"ok","schemas":[{"type":"table","name":"attempts","table":"attempts","sql":"CREATE TABLE attempts (\n                    operation_id TEXT NOT NULL REFERENCES operations(operation_id),\n                    attempt_no INTEGER NOT NULL CHECK(attempt_no > 0),\n                    state TEXT NOT NULL CHECK(state IN ('started','response','uncertain')),\n                    exposure_units INTEGER NOT NULL CHECK(exposure_units >= 0),\n                    response_status INTEGER,\n                    raw_response BLOB,\n                    started_at REAL NOT NULL,\n                    completed_at REAL,\n                    error TEXT,\n                    PRIMARY KEY(operation_id, attempt_no)\n                )"},{"type":"table","name":"config","table":"config","sql":"CREATE TABLE config (\n                    singleton INTEGER PRIMARY KEY CHECK(singleton=1),\n                    exposure_cap INTEGER NOT NULL CHECK(exposure_cap >= 0),\n                    call_cap INTEGER NOT NULL CHECK(call_cap >= 0)\n                )"},{"type":"table","name":"operations","table":"operations","sql":"CREATE TABLE operations (\n                    operation_id TEXT PRIMARY KEY,\n                    branch TEXT NOT NULL,\n                    request BLOB NOT NULL,\n                    exposure_per_attempt INTEGER NOT NULL CHECK(exposure_per_attempt >= 0),\n                    retry_bound INTEGER NOT NULL DEFAULT 0 CHECK(retry_bound IN (0,1)),\n                    retry_429_authorized INTEGER NOT NULL DEFAULT 0 CHECK(retry_429_authorized IN (0,1)),\n                    retry_max_attempts INTEGER NOT NULL DEFAULT 1,\n                    retry_base_backoff REAL NOT NULL DEFAULT 0.25,\n                    retry_max_backoff REAL NOT NULL DEFAULT 8.0,\n                    state TEXT NOT NULL CHECK(state IN ('ready','started','succeeded','failed','uncertain')),\n                    attempts INTEGER NOT NULL DEFAULT 0 CHECK(attempts >= 0),\n                    response_status INTEGER,\n                    raw_response BLOB,\n                    parse_status TEXT,\n                    parsed_json TEXT,\n                    parse_error TEXT,\n                    error TEXT\n                )"},{"type":"table","name":"vertex_attempts","table":"vertex_attempts","sql":"CREATE TABLE vertex_attempts (\n                    operation_id TEXT PRIMARY KEY,\n                    logical_id TEXT NOT NULL REFERENCES vertex_calls(logical_id),\n                    kind TEXT NOT NULL CHECK(kind IN ('count','generation')),\n                    attempt_no INTEGER NOT NULL CHECK(attempt_no IN (0,1)),\n                    endpoint TEXT NOT NULL, request_sha256 TEXT NOT NULL,\n                    reserved_micro_usd INTEGER NOT NULL,\n                    settled_micro_usd INTEGER,\n                    state TEXT NOT NULL DEFAULT 'prepared',\n                    http_status INTEGER, response_sha256 TEXT, response_bytes INTEGER,\n                    observed_model TEXT, usage_json TEXT, finish_reason TEXT,\n                    count_tokens INTEGER,\n                    UNIQUE(logical_id,kind,attempt_no)\n                )"},{"type":"table","name":"vertex_calls","table":"vertex_calls","sql":"CREATE TABLE vertex_calls (\n                    logical_id TEXT PRIMARY KEY, ordinal INTEGER NOT NULL UNIQUE,\n                    stage TEXT NOT NULL, role_sha256 TEXT NOT NULL,\n                    request BLOB NOT NULL, request_sha256 TEXT NOT NULL,\n                    status TEXT NOT NULL DEFAULT 'prepared', error TEXT\n                )"},{"type":"table","name":"vertex_run","table":"vertex_run","sql":"CREATE TABLE vertex_run (\n                    singleton INTEGER PRIMARY KEY CHECK(singleton=1),\n                    contract BLOB NOT NULL, halted TEXT\n                )"}]}
